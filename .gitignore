# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# image pipeline scratch (regenerate with: python scripts/process_images.py --contact)
images/_work

# Python pipeline
__pycache__/
*.pyc

# API keys. scripts/generate_images.py reads $OPENAI_API_KEY and nothing else, but a
# .env is the usual place a key ends up on the way there, so it must never be committable.
.env
.env.*
!.env.example

# Superseded generated raws. `generate_images.py --force` moves the old art here rather
# than overwriting it, and process_images.py's non-recursive walk of images/_raw then
# stops seeing it. Kept on disk, not in history.
images/_raw/AlreadyProcessed/
